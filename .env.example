# Security
SECRET_KEY=your-super-secret-django-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Database (MySQL)
DB_NAME=bmsappcom
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Face Matching Settings
FACE_MATCH_THRESHOLD=0.40
FACE_MATCH_MARGIN=0.10
MIN_FACE_ENROLLMENT_SAMPLES=3

# Limits
DATA_UPLOAD_MAX_MEMORY_SIZE=41943040
FILE_UPLOAD_MAX_MEMORY_SIZE=12582912

# DRF Throttle
DRF_ANON_THROTTLE=30/min
DRF_USER_THROTTLE=120/min
DRF_ATTENDANCE_THROTTLE=10/min
